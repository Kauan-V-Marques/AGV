# Configuracao local do AGV. Copie para agv.env (fora do Git) e ajuste:
#   cp agv.env.exemplo agv.env
# O launcher (launch_production.py) le este arquivo; variaveis ja exportadas no
# ambiente tem prioridade. Todas as opcoes estao no README, secao 15.

# Portas fixas criadas pela regra udev (sudo bash scripts/instalar_regras_udev.sh)
AGV_ARDUINO_PORT=/dev/agv-arduino
AGV_LIDAR_PORT=/dev/rplidar

# Quadros por segundo dos streams (o Kinect captura a 30). Em Wi-Fi fraco, volte a 6 / 4.
AGV_VIDEO_FPS=15
AGV_DEPTH_FPS=10

# Montagem do RPLIDAR: angulo do laser que aponta para a frente do AGV (graus, sentido
# horario) e posicao em relacao ao eixo das rodas (m; x para a frente, y para a esquerda).
AGV_LIDAR_FRENTE_GRAUS=0
AGV_LIDAR_X_M=0
AGV_LIDAR_Y_M=0
# Faixas a ignorar (graus do AGV, 0 = frente, positivo para a esquerda), ex.: 170:190
AGV_LIDAR_MASCARA=

# Chassi em volta do eixo das rodas (m): as folgas do LIDAR sao medidas da borda
AGV_FRENTE_M=0.30
AGV_TRASEIRA_M=0.30
AGV_LARGURA_M=0.50
